# Local Plate Transcriber — Windows setup
#
# Copy to `.env` and fill in keys. The app runs without keys but phase 1
# (transcription) needs a model key and phase 2 (research) needs a search key.

# Model for blind transcription + comparison. `anthropic` or `openai-compatible`.
MODEL_PROVIDER=anthropic
MODEL_API_KEY=
# e.g. claude-sonnet-4-5 for anthropic; any vision model name for openai-compatible.
MODEL_NAME=claude-sonnet-4-5
# Only for openai-compatible (OpenAI default). Point at any chat-completions endpoint.
MODEL_BASE_URL=https://api.openai.com/v1

# Web search for phase 2 cross-references (Brave Search API; free tier exists).
# Without it, research runs with zero sources and says so plainly.
SEARCH_API_KEY=

# Local port.
PORT=3105

# Passwordless login (same setup as Bottom Drawer: email + 6-digit code).
AUTH_PEPPER=generate-with-node-crypto-and-paste-here
AUTH_FROM_EMAIL=login@yourdomain.com
RESEND_API_KEY=
# Print sign-in codes to the server console instead of emailing (debug only).
AUTH_DEV_PRINT_CODE=false

# Stripe billing (HelmutReads Researcher/Institution). Test keys for debug.
BILLING_MODE=test
STRIPE_SECRET_KEY=
STRIPE_RESEARCHER_PRICE=
STRIPE_INSTITUTION_PRICE=
STRIPE_WEBHOOK_SECRET=
FREE_RUN_LIMIT=10
APP_ORIGIN=http://localhost:3105
ADMIN_EMAILS=you@example.com
